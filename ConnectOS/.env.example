# انسخ الملف ده لـ .env واملأ القيم الحقيقية بتاعتك قبل تشغيل المشروع في
# بيئة إنتاج فعلية. المشروع بيشتغل بدونه في التطوير المحلي بقيم افتراضية آمنة.

# ===== أمان أساسي (إلزامي في الإنتاج) =====
DJANGO_SECRET_KEY=غيّر-القيمة-دي-لمفتاح-عشوائي-طويل-وسري
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ===== قاعدة البيانات (PostgreSQL في الإنتاج) =====
DB_ENGINE=postgresql
DB_NAME=connectos
DB_USER=connectos
DB_PASSWORD=غيّر-القيمة-دي
DB_HOST=localhost
DB_PORT=5432

# ===== بوابة الدفع Paymob (اختياري — الدفع بيتعطّل بلطف من غيرها) =====
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# ===== ربط RADIUS بجهاز الميكروتيك (اختياري) =====
RADIUS_SERVER_HOST=radius.yourdomain.com
MIKROTIK_API_DEFAULT_PORT=8728
MIKROTIK_API_TIMEOUT=4

# ===== سيرفر VPN لفتح الأجهزة خلف NAT (اختياري — شوف VPN_SETUP.md) =====
VPN_PUBLIC_HOST=vpn.yourdomain.com

# ===== بريد إلكتروني حقيقي (لصفحة نسيت كلمة المرور) =====
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ConnectOS <no-reply@yourdomain.com>
