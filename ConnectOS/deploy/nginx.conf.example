# مثال إعداد Nginx كـ reverse proxy أمام Gunicorn.
# انسخه إلى /etc/nginx/sites-available/connectos ثم اعمل symlink في sites-enabled.

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;

    location /static/ {
        alias /path/to/connectos/staticfiles/;
    }
    location /media/ {
        alias /path/to/connectos/media/;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
# بعد ما SSL يتظبط بـ certbot، certbot هيضيف تلقائيًا تحويل https + بلوك 443.
