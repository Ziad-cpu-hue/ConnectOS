# مثال Systemd service لتشغيل Gunicorn كخدمة دائمة (بديل لو مش هتستخدم Docker/Procfile).
# انسخه إلى /etc/systemd/system/connectos.service
# ثم: sudo systemctl daemon-reload && sudo systemctl enable --now connectos

[Unit]
Description=ConnectOS Gunicorn Service
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/path/to/connectos
EnvironmentFile=/path/to/connectos/.env
ExecStart=/path/to/venv/bin/gunicorn connectos.wsgi:application \
    --bind 127.0.0.1:8000 --workers 3 --timeout 60
Restart=always

[Install]
WantedBy=multi-user.target
